{
  "description": "漫画編集会議の Hooks。NFD チェックポイントで会議経験を自動保存する。",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/nfd-checkpoint.sh",
            "timeout": 15000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/nfd-checkpoint.sh",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}
